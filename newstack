# 1) keep only Fractions.mrc
grep -E '^Position_8_.*_Fractions\.mrc$' file.txt > fractions_only.txt

# 2) sort by angle inside [X_00]
awk -F'[][]' '
  NF>=2 {
    split($2,a,"_");                 # a[1] = angle (e.g. -33)
    printf "%g\t%s\n", a[1], $0
  }
' fractions_only.txt \
| sort -n -k1,1 \
| cut -f2- > file_sorted.txt

# 3) build fileinlist.txt
N=$(wc -l < file_sorted.txt)
{
  echo "$N"
  awk '{print; print "/"}' file_sorted.txt
} > fileinlist.txt


newstack -fileinlist fileinlist.txt -output Position_26_2.mrc
